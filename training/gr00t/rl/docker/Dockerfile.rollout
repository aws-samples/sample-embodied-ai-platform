# GR00T RL Rollout Worker — Isaac Sim + RLinf + GR00T + Ray
# Runs on g6e.4xlarge (1× L40S) as rollout worker nodes.
FROM nvcr.io/nvidia/isaac-sim:5.1.0

USER root

# System dependencies
RUN mkdir -p /var/lib/apt/lists/partial \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    git git-lfs cmake sudo curl wget \
    && rm -rf /var/lib/apt/lists/*

# All dependencies from pinned requirements file.
# Use --ignore-installed to override Isaac Sim's partial/conflicting packages.
COPY requirements-rollout.txt /tmp/requirements-rollout.txt
RUN /isaac-sim/python.sh -m pip install --no-cache-dir --ignore-installed \
    -r /tmp/requirements-rollout.txt \
    && /isaac-sim/python.sh -c "import ray; print(f'OK: ray {ray.__version__}')"

# flash-attn requires CUDA toolkit to compile from source.
# Installed at container startup on GPU nodes via entrypoint.
# For inference-only rollouts, PyTorch SDPA is used as fallback.

# IsaacLab (installed from EFS mount at runtime)
# RLinf (installed from EFS mount at runtime)

WORKDIR /workspace

COPY entrypoint.sh /workspace/entrypoint.sh
RUN chmod +x /workspace/entrypoint.sh

ENTRYPOINT ["/workspace/entrypoint.sh"]
