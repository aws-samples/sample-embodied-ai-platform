# GR00T RL Learner — RLinf + GR00T + Ray (no Isaac Sim)
# Runs on g7e.48xlarge (8× PRO 6000) as the FSDP learner node.
FROM nvcr.io/nvidia/cuda:12.8.0-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git git-lfs cmake sudo curl wget \
    python3.11 python3.11-dev python3.11-venv python3-pip \
    libgl1-mesa-glx libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

# PyTorch + CUDA 12.8 (matching i4h-workflows Rheo Dockerfile)
RUN pip install --no-cache-dir --no-build-isolation --use-pep517 \
    torch==2.8.0 torchvision==0.23.0

# All other dependencies from pinned requirements file
COPY requirements-learner.txt /tmp/requirements-learner.txt
RUN pip install --no-cache-dir -r /tmp/requirements-learner.txt \
    && python3 -c "from transformers import AutoModelForVision2Seq; import ray; print(f'OK: transformers + ray {ray.__version__}')"

# flash-attn requires --no-build-isolation and CUDA toolkit (available in this image)
ENV CUDA_HOME=/usr/local/cuda
RUN pip install --no-cache-dir --no-build-isolation flash-attn==2.8.3

WORKDIR /workspace

COPY entrypoint.sh /workspace/entrypoint.sh
RUN chmod +x /workspace/entrypoint.sh

ENTRYPOINT ["/workspace/entrypoint.sh"]
